# Public repository: deny by default. Add new publishable files explicitly.
/*
/.*/

!/.gitignore
!/README.md
!/pult_config.json
!/pult_core.py
!/pult_planner.py
!/pult_store.py
!/telegram_channel.py
!/telegram_publish.py
!/telegram_pult.py
!/test_pult_planner.py
!/test_pult_store.py
!/test_telegram_publish.py
!/test_telegram_pult.py

!/.agents/
/.agents/**
!/.agents/skills/
!/.agents/skills/auqni-content-factory/
!/.agents/skills/auqni-content-factory/SKILL.md
!/.agents/skills/auqni-content-orchestrator/
!/.agents/skills/auqni-content-orchestrator/SKILL.md
!/.codex/
/.codex/**
!/.codex/agents/
!/.codex/agents/auqni-content-writer.toml
!/.codex/agents/auqni-image-generator.toml
!/.codex/agents/auqni-publisher.toml
!/.codex/agents/auqni-video-generator.toml

!/monitoring/
/monitoring/**
!/monitoring/check.py
!/monitoring/config.json
!/monitoring/editorial.py

!/docs/
/docs/**
!/docs/editorial-policy-v1.md
!/docs/visual-guide-auqni-content-v1.md
!/docs/source-registry-v1.json

!/examples/
/examples/**
!/examples/demo-content.json
!/screenshots/
/screenshots/**
!/screenshots/README.md

# Explicit safety rules also apply if the allowlist is expanded later.
**/.env
**/.env.*
**/*secret*
**/*credential*
**/*.pem
**/*.key
**/*.p12
**/id_rsa
**/id_ed25519
**/*.sqlite
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.db-*
**/__pycache__/
**/*.pyc
**/inbox/
**/backups/
**/*.jsonl
**/*.log
**/*.lock
**/*.ogg
**/*.mp4
**/editorial_state.sqlite3
**/orchestrator-input.json
**/review-decisions.json
